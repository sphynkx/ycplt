[Unit]
Description=ycplt - local chat application (FastAPI + llama-cpp-python)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/ycplt

# No User= — this deployment runs as root.
EnvironmentFile=/var/www/ycplt/.env

ExecStart=/var/www/ycplt/.venv/bin/python /var/www/ycplt/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
